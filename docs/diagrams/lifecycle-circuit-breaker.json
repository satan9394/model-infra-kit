  "cards": [
    { "dot": "emerald", "title": "为什么是「被动健康」", "items": ["没有定时器、没有主动探测、没有跨实例全局状态", "只根据真实调用的结果积累，实例级内存 Map", "健康键在 adaptive_qos 模式按模型粒度，其余按供应商粒度"] },
    { "dot": "amber", "title": "阈值的默认与可注入性", "items": ["failureThreshold 默认 3，cooldownMs 默认 30_000", "两者必须是正整数安全整数，否则构造即抛错", "now 可注入，测试用假时钟验证冷却与半开，不依赖真实等待"] },
    { "dot": "rose", "title": "只有 retryable 才计入失败", "items": ["HTTP 状态优先：429 与 5xx 计入；4xx 不计入且视为成功（清除记录）", "无状态时按错误码判定：RATE_LIMIT / TIMEOUT / CONNECTION / PROVIDER", "非 retryable 的错误维持原状态，不会误伤健康供应商"] },
    { "dot": "cyan", "title": "单探针不变量", "items": ["acquire 同步占位，先于任何网络等待，避免并发探测风暴", "取消（release）既不宣告成功也不宣告失败，直接回 OPEN", "成功的探测删除整条健康记录，回到无记录即 CLOSED"] }
  ]
