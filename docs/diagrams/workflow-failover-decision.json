  "cards": [
    {
      "dot": "emerald",
      "title": "只有这四类失败会轮换",
      "items": [
        "429、超时、连接失败、上游 5xx",
        "HTTP 状态优先于 SDK 文案分类，避免 5xx 被归类成 UNKNOWN",
        "4xx（除 429）判终局；流式一旦已输出文本或工具调用则禁止重放"
      ]
    },
    {
      "dot": "amber",
      "title": "两级轮换的顺序",
      "items": [
        "先在同一候选内按 KeyPool 轮换凭据，429 使该 Key 内存冷却（默认 30s）",
        "Key 用尽才切到下一个候选模型或供应商",
        "熔断按供应商粒度计数，连续 3 次 retryable 失败进入 OPEN"
      ]
    },
    {
      "dot": "rose",
      "title": "HALF_OPEN 的单探针不变量",
      "items": [
        "冷却到期后仅允许一次探测：acquire 同步占位，先于网络等待",
        "探测成功即清除健康记录，回到 CLOSED",
        "调用方取消（release）既不算成功也不算失败，直接回 OPEN"
      ]
    },
    {
      "dot": "cyan",
      "title": "记账口径",
      "items": [
        "每次实际尝试各落一行 usage；失败行 status=error 且成本缺失",
        "通过模型或 Key 轮换成功的行打 is_fallback=true",
        "凭据只存 api_key_ref；池状态只在内存，不进库、不进日志"
      ]
    }
  ]
}