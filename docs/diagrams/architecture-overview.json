  "cards": [
    {
      "dot": "cyan",
      "title": "三种接入面（SPEC §2）",
      "items": [
        "嵌入式库：ModelInfra.init() → generate / stream / usage.summary",
        "fetch 适配器：new OpenAI({ baseURL: mik.baseUrl, fetch: mik.fetch })",
        "本地服务：mik serve → /v1 兼容端点，跨语言项目改 base_url 即接入"
      ]
    },
    {
      "dot": "emerald",
      "title": "薄核与自研边界（D1 / D2 / SPEC §1）",
      "items": [
        "协议与 usage 归一交给 Vercel AI SDK；自研只有 Registry / CredentialStore / UsageRecorder / UsageRepository",
        "模型名归一与成本计算交给 llm-pricing；本项目只编排价格优先级",
        "协议是一等公民：PROTOCOLS 源表按数据映射，禁止 providerId 分支"
      ]
    },
    {
      "dot": "amber",
      "title": "金额与密钥口径（D3 / 硬性规则 4）",
      "items": [
        "落库与聚合全程整数微美元，禁止 SUM(CAST(cost AS REAL))",
        "providers 表只存 api_key_ref；密钥永不落库、永不出现在日志",
        "历史成本永不重算：事件落库即固化 cost / pricing_source / pricing_basis"
      ]
    },
    {
      "dot": "rose",
      "title": "可靠性与边界（D4 / D8 / 规则 6）",
      "items": [
        "init() 不因目录或价格上游失败而抛错，只降级 + onWarn",
        "node:sqlite 默认驱动（WAL + busy_timeout），驱动接口可替换",
        "看板只走 mik serve 的 HTTP API，不直接打开 SQLite"
      ]
    }
  ]
}