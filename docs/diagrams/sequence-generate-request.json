  "cards": [
    {
      "dot": "emerald",
      "title": "计量只发生一次（SPEC §1 / D1）",
      "items": [
        "三条接入面（嵌入式 / mik.fetch / HTTP /v1）最终都走 hub.generate 或 hub.stream",
        "协议差异由 PROTOCOLS 源表数据映射决定，没有 providerId 分支",
        "usage 归一与长上下文、思考模式分档交给 AI SDK + llm-pricing"
      ]
    },
    {
      "dot": "amber",
      "title": "价格优先级与固化（SPEC §4）",
      "items": [
        "优先级：pricing_overrides（手动）> llm-pricing overrides > 上游目录 > 内置 archive",
        "字段缺失一律降级为 undefined，绝不当作 0",
        "事件落库即固化 cost / pricing_source / pricing_basis，历史永不重算"
      ]
    },
    {
      "dot": "rose",
      "title": "失败与重试路径（EVO-G95）",
      "items": [
        "仅 429 / 超时 / 连接 / 上游 5xx 触发模型降级；流式仅在尚未输出前切换",
        "429 后该凭据内存冷却（默认 30s），数据库仍只存 api_key_ref",
        "失败尝试同样落一行 usage（status=error、缺失成本）"
      ]
    },
    {
      "dot": "cyan",
      "title": "传输细节",
      "items": [
        "流式先写 text/event-stream，再逐事件下发；超长首字时发心跳注释保活",
        "X-ModelHub-Provider 只在 /v1/chat/completions 生效，且不是凭据通道",
        "看板不直连 SQLite，只读这里的 HTTP API"
      ]
    }
  ]
