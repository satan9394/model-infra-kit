  "cards": [
    {
      "dot": "amber",
      "title": "整数微美元贯穿全链（D3）",
      "items": [
        "落库列是 INTEGER：cost_micros / cost_low_micros / cost_high_micros / cache_savings_micros",
        "SQL 聚合统一 CAST(ROUND(x*1000000) AS INTEGER)，禁止浮点求和",
        "明细 → 按日 → 按标签三层折叠满足结合律，明细加总等于汇总"
      ]
    },
    {
      "dot": "rose",
      "title": "价格来源与固化（SPEC §4 / EVO-G73）",
      "items": [
        "优先级：pricing_overrides（手动）> llm-pricing overrides > 上游目录 > 内置 archive",
        "供应商回传账单（source=provider）覆盖目录估算：low=high=usd、basis=exact",
        "原始回传值与状态写进保留标签键（provider_cost_raw / provider_cost_status）供对账"
      ]
    },
    {
      "dot": "emerald",
      "title": "折叠与归档的诚实边界",
      "items": [
        "折叠表不保存 pricing_source，故未定价占比只能覆盖仍保留的明细行",
        "归档修剪前在 IMMEDIATE 事务内比对摘要与两套账本，差 1 微美元即拒绝",
        "聚合无法重建单步细节；接口与看板显式说明保留范围"
      ]
    },
    {
      "dot": "cyan",
      "title": "出口的可靠性分级",
      "items": [
        "HTTP /api/usage/* 由服务层统一推导 costBound()，CLI 与看板共用同一口径",
        "看板不直连 SQLite，只读 HTTP API",
        "Webhook 是记账提交后的尽力而为旁路（HMAC 签名、有界重试、重启丢队列），不替代账本"
      ]
    }
  ]
